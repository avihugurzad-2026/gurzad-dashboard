# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit it.

# Supabase direct Postgres connection string
# Found in: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT signing secret — min 32 random characters
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# bcrypt hash of your login password
# Generate: npm run hash-password -- "your-password-here"
OWNER_PASSWORD_HASH=

# Origin allowed for CORS (your Vercel deployment URL, or http://localhost:3000 for dev)
ALLOWED_ORIGIN=http://localhost:3000

# Absolute path to your Obsidian vault (used by sync script only, never by the web server)
OBSIDIAN_VAULT=/Users/avihugurzad/Documents/Obsidian Vault

# Port for local dev
PORT=3000

# Set to "production" on Vercel (enables Secure cookie flag)
# NODE_ENV=production

# Buyz (Head Spa Israel booking/POS) revenue API key. Server-side only.
# Set locally and in Vercel (Production + Preview).
BUYZ_API_KEY=

# Protects /api/cron/buyz (Vercel Cron sends it as a Bearer token). Vercel Production only.
CRON_SECRET=
