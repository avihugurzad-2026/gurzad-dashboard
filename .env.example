# Copy to .env.local (dev) / Vercel env vars (prod). Never commit real values.
# Without VITE_SUPABASE_* the app runs in demo mode on sample data (OTP demo code: 123456).

# --- Client (public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Vercel functions) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-dashboard.vercel.app
# The one email that becomes the workspace owner on first sign-in
OWNER_EMAIL=

# Resend — OTP and invitation emails. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="Dashboard <login@your-verified-domain>"

# Gemini (receipt scanning + WhatsApp agent brain)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kapso WhatsApp API — https://docs.kapso.ai
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Comma-separated WhatsApp numbers allowed to talk to the agent (E.164 without +)
WHATSAPP_ALLOWED_NUMBERS=

# Status checks cron protection
CRON_SECRET=

# Web Push (phone notifications). Generate once:  npx web-push generate-vapid-keys
# The public key is safe to expose; the private key is server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain

# Google Calendar (each user connects their own calendar). Google Cloud Console → APIs & Services:
# enable "Google Calendar API", create an OAuth client of type "Web application" and add the redirect URI
#   <APP_URL>/api/google?action=callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: separate key for encrypting stored Google tokens (defaults to one derived from the client secret)
GOOGLE_TOKEN_KEY=
# (CALENDAR_TOKEN_KEY is accepted too)

# Marketing › Meta reach (Eden's business). Best: a System User token from that Business Manager (never expires) with
# ads_read, read_insights, pages_read_engagement, pages_show_list, instagram_basic, instagram_manage_insights.
# The Instagram account is found through the Page.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Optional: META_IG_USER_ID (if Instagram is not linked to the Page), META_GRAPH_VERSION (default v23.0)

# Marketing › Sites (Google Analytics 4 + Search Console). JSON key of a Google service account (raw JSON or base64).
# Add the service account's email as Viewer on each GA4 property and as a user in Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
